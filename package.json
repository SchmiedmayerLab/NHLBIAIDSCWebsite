{
  "name": "nhlbi-ai-stanford-dsc-website",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:test": "node scripts/serve-built-site.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix && npm run lint:md -- --fix",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:md": "markdownlint-cli2",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:md-links": "node scripts/audit-markdown-links.mjs",
    "test:site": "node scripts/audit-built-site.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:site",
    "validate": "npm run format:check && npm run lint && npm run check && npm run test:md-links && npm run test:coverage && npm run build && npm run test:site",
    "test:portability": "SITE_URL=https://example.github.io SITE_BASE=/NHLBIAIDSCWebsite npm run build && SITE_URL=https://example.github.io SITE_BASE=/NHLBIAIDSCWebsite npm run test:site",
    "validate:all": "npm run validate && npm run test:e2e && npm run test:portability",
    "ci": "npm run validate"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "github-slugger": "^2.0.0",
    "globals": "^17.11.0",
    "markdown-it": "^15.0.1",
    "markdownlint-cli2": "^0.23.2",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "table": {
      "ajv": "8.18.0"
    },
    "yaml-language-server": {
      "ajv": "8.18.0"
    }
  }
}
